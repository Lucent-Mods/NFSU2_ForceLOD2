// Version resource. Beyond being good practice for a released binary, a file with no version
// information at all scores noticeably worse with antivirus heuristics.
#include <winver.h>

#define VER_MAJOR 1
#define VER_MINOR 0
#define VER_PATCH 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HellRaven-Mods"
            VALUE "FileDescription",  "NFSU2 ForceLOD 2 - full detail, full map and RTX Remix support"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "NFSU2_ForceLOD2"
            VALUE "LegalCopyright",   "Open source. Not affiliated with Electronic Arts."
            VALUE "OriginalFilename", "NFSU2_ForceLOD2.asi"
            VALUE "ProductName",      "NFSU2 ForceLOD 2"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "ASI plugin for Need for Speed Underground 2. Source: https://github.com/HellRaven-Mods/NFSU2_ForceLOD2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
